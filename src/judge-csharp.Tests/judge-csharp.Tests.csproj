<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>judge_csharp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <JudgeSource Condition="'$(JudgeSource)' == ''">../judge-csharp</JudgeSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(JudgeSource)/EventHandling/OutputHandler.cs" Link="judge-csharp\EventHandling\OutputHandler.cs" />
    <Compile Include="$(JudgeSource)/Json/*.cs" Link="judge-csharp\Json\%(Filename)%(Extension)" />
    <Compile Include="$(JudgeSource)/Feedback/*.cs" Link="judge-csharp\Feedback\%(Filename)%(Extension)" />
    <Compile Include="$(JudgeSource)/Util/*.cs" Link="judge-csharp\Util\%(Filename)%(Extension)" />
    <Content Include="fixtures\*.xml" Link="fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Microsoft.NET.Test.Sdk 17.8.0 needs Newtonsoft.Json 13 or newer, the judge pins 12.0.2. -->
    <PackageReference Include="Newtonsoft.Json" Version="12.0.2" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
  </ItemGroup>
</Project>
